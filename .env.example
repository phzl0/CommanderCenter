POSTGRES_DB=command_center
POSTGRES_USER=command_center
POSTGRES_PASSWORD=change-this-local-password

# Opcional: cotações diárias de empresas (não é necessário para usar o sistema)
ALPHA_VANTAGE_API_KEY=

# Optional account connections, credentials stay in the backend
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=organizations

# Must match the browser address and registered OAuth callback origin
INTEGRATION_ORIGIN=http://localhost:5173

# Optional Google Calendar read-only connection
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lembretes por e-mail (opcional; senha de aplicativo do provedor)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
